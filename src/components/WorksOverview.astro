---
import {
	type WorkEntry,
	type WorkMedium,
	type WorkStatus,
	mediumLabel,
	statusLabel,
	worksEntries,
} from '~/data/works';

const mediumOrder: WorkMedium[] = [
	'anime',
	'manga',
	'novel',
	'film',
	'series',
	'game',
];

const statusOrder: WorkStatus[] = ['active', 'done', 'paused'];

const sortByUpdatedAt = (entries: WorkEntry[]) =>
	[...entries].sort(
		(left, right) =>
			new Date(right.updatedAt).getTime() - new Date(left.updatedAt).getTime(),
	);

const worksByUpdatedAt = sortByUpdatedAt(worksEntries);
const latestEntry = worksByUpdatedAt[0];

const totalCount = worksEntries.length;
const activeCount = worksEntries.filter(
	(entry) => entry.status === 'active',
).length;
const mediumCounts = mediumOrder.map((medium) => ({
	medium,
	label: mediumLabel[medium],
	count: worksEntries.filter((entry) => entry.medium === medium).length,
}));

const sectionByStatus = statusOrder.map((status) => ({
	status,
	label: statusLabel[status],
	entries: worksByUpdatedAt.filter((entry) => entry.status === status),
}));

const overviewByMedium = mediumOrder.map((medium) => ({
	medium,
	label: mediumLabel[medium],
	entries: worksByUpdatedAt.filter((entry) => entry.medium === medium),
}));

const dateFormatter = new Intl.DateTimeFormat('zh-CN', {
	year: 'numeric',
	month: 'short',
	day: 'numeric',
});

const formatDate = (value: string) => dateFormatter.format(new Date(value));

const coverTitle = (title: string) => {
	const compact = title.replace(/\s+/g, '');
	return compact.length <= 4 ? compact : compact.slice(0, 4);
};
---

<section class="mx-auto max-w-6xl space-y-12">
	<div class="flex items-start justify-between gap-6">
		<div class="space-y-4">
			<p class="text-sm uppercase tracking-[0.35em] opacity-55">Leisure Overview</p>
			<h1 class="text-5xl font-extrabold leading-tight">所有作品放在一页里看。</h1>
			<p class="max-w-2xl leading-8 opacity-80">
				这里集中放媒体分布、状态分组、完整总览和统计。主页面继续保持轻一点，只留最近在追。
			</p>
		</div>
		<a class="text-sm opacity-65 hover:opacity-100" href="/works">返回最近在追</a>
	</div>

	<div class="grid gap-4 sm:grid-cols-3">
		<div class="rounded-2xl border border-neutral-200 bg-neutral-100/70 p-5 dark:border-neutral-700 dark:bg-neutral-900/40">
			<p class="text-sm opacity-60">总条目</p>
			<p class="mt-2 text-3xl font-bold">{totalCount}</p>
		</div>
		<div class="rounded-2xl border border-neutral-200 bg-neutral-100/70 p-5 dark:border-neutral-700 dark:bg-neutral-900/40">
			<p class="text-sm opacity-60">最近在动</p>
			<p class="mt-2 text-3xl font-bold">{activeCount}</p>
		</div>
		<div class="rounded-2xl border border-neutral-200 bg-neutral-100/70 p-5 dark:border-neutral-700 dark:bg-neutral-900/40">
			<p class="text-sm opacity-60">最近更新</p>
			<p class="mt-2 text-xl font-semibold">
				{latestEntry ? formatDate(latestEntry.updatedAt) : '还没有'}
			</p>
		</div>
	</div>

	<section class="space-y-5">
		<div class="flex items-center justify-between gap-4">
			<h2 class="text-3xl font-bold">媒体分布</h2>
			<p class="text-sm opacity-55">先看结构，再看单条作品</p>
		</div>
		<ul class="grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
			{
				mediumCounts.map((item) => (
					<li class="rounded-2xl border border-neutral-200/80 bg-neutral-100/70 px-4 py-4 dark:border-neutral-700 dark:bg-neutral-900/30">
						<div class="flex items-center justify-between gap-3">
							<p class="font-semibold">{item.label}</p>
							<p class="text-sm opacity-60">{item.count} 部</p>
						</div>
					</li>
				))
			}
		</ul>
	</section>

	<section class="space-y-5">
		<h2 class="text-3xl font-bold">按状态看</h2>
		<div class="grid gap-6 xl:grid-cols-3">
			{
				sectionByStatus.map((section) => (
					<section class="rounded-[1.75rem] border border-neutral-200 p-6 dark:border-neutral-700">
						<div class="mb-5 flex items-center justify-between gap-4">
							<h3 class="text-2xl font-bold">{section.label}</h3>
							<p class="text-sm opacity-55">{section.entries.length} 部</p>
						</div>
						{section.entries.length > 0 ? (
							<ul class="space-y-4">
								{section.entries.map((entry) => (
									<li class="rounded-2xl bg-neutral-100/80 px-4 py-3 dark:bg-neutral-900/40">
										<div class="flex items-center justify-between gap-3">
											<div>
												<p class="font-semibold">{entry.title}</p>
												<p class="text-sm opacity-65">
													{mediumLabel[entry.medium]} · {entry.progress}
												</p>
											</div>
											<p class="text-sm opacity-55">{formatDate(entry.updatedAt)}</p>
										</div>
									</li>
								))}
							</ul>
						) : (
							<p class="leading-7 opacity-60">这一栏还空着，之后加条目就会自动出现在这里。</p>
						)}
					</section>
				))
			}
		</div>
	</section>

	<section class="space-y-5">
		<div>
			<h2 class="text-3xl font-bold">完整总览</h2>
			<p class="mt-2 max-w-2xl leading-7 opacity-75">
				不只动画。漫画、小说、电影、剧集和游戏，都在这里按媒介归档。
			</p>
		</div>

		<div class="space-y-8">
			{
				overviewByMedium.map((group) => (
					<section class="space-y-4">
						<div class="flex items-center justify-between gap-4">
							<h3 class="text-2xl font-bold">{group.label}</h3>
							<p class="text-sm opacity-55">{group.entries.length} 部</p>
						</div>
						{group.entries.length > 0 ? (
							<ul class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
								{group.entries.map((entry) => (
									<li class="rounded-[1.5rem] border border-neutral-200 bg-neutral-50 p-4 dark:border-neutral-700 dark:bg-neutral-900/25">
										<div class="mb-4 flex items-center gap-4">
											{entry.cover ? (
												<img
													src={entry.cover}
													alt={`${entry.title} cover`}
													class="h-20 w-16 shrink-0 rounded-2xl object-cover shadow-sm"
													loading="lazy"
												/>
											) : (
												<div
													class="flex h-20 w-16 shrink-0 items-end rounded-2xl p-3 text-sm font-bold text-neutral-950 shadow-sm"
													style={`background: linear-gradient(155deg, ${entry.accent.from}, ${entry.accent.to}); box-shadow: 0 12px 35px -22px ${entry.accent.glow};`}
												>
													{coverTitle(entry.title)}
												</div>
											)}
											<div class="min-w-0">
												<p class="truncate text-lg font-semibold">{entry.title}</p>
												<p class="text-sm opacity-70">{statusLabel[entry.status]}</p>
											</div>
										</div>
										<p class="text-sm leading-6 opacity-75">{entry.progress}</p>
										<p class="mt-2 text-sm opacity-60">更新于 {formatDate(entry.updatedAt)}</p>
										{entry.note && <p class="mt-3 text-sm leading-6 opacity-75">{entry.note}</p>}
									</li>
								))}
							</ul>
						) : (
							<div class="rounded-[1.5rem] border border-dashed border-neutral-300 px-5 py-6 opacity-70 dark:border-neutral-700">
								<p class="leading-7">
									这里先留空。之后只要在 `src/data/works.ts`
									增加条目，这个分区就会自动补上。
								</p>
							</div>
						)}
					</section>
				))
			}
		</div>
	</section>
</section>
