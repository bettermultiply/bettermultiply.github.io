---
import { mediumLabel, statusLabel, worksEntries } from '~/data/works';

const recentEntries = [...worksEntries]
	.filter((entry) => entry.status === 'active')
	.sort(
		(left, right) =>
			new Date(right.updatedAt).getTime() - new Date(left.updatedAt).getTime(),
	)
	.slice(0, 3);

const dateFormatter = new Intl.DateTimeFormat('zh-CN', {
	year: 'numeric',
	month: 'short',
	day: 'numeric',
});

const formatDate = (value: string) => dateFormatter.format(new Date(value));

const coverTitle = (title: string, shortTitle?: string) => {
	if (shortTitle) return shortTitle;
	const compact = title.replace(/\s+/g, '');
	return compact.length <= 4 ? compact : compact.slice(0, 4);
};
---

<section class="mx-auto max-w-6xl space-y-10">
	<div class="space-y-5">
		<p class="text-sm uppercase tracking-[0.35em] opacity-55">Leisure Log</p>
		<h1 class="max-w-3xl text-5xl font-extrabold leading-tight">
			只留下最近还在追的那些作品。
		</h1>
		<p class="max-w-2xl leading-8 opacity-80">
			这一页只看近期有进度的内容，节奏和现在一样直接。完整的统计、状态分区和全部条目，都收进独立总览页里。
		</p>
	</div>

	<section class="space-y-5">
		<div class="flex items-end justify-between gap-4">
			<div>
				<h2 class="text-3xl font-bold">最近在追</h2>
				<p class="mt-2 max-w-2xl leading-7 opacity-75">
					按最近更新时间排序，只展示 3 个，把焦点收得更紧。
				</p>
			</div>
			<a class="text-sm opacity-65 hover:opacity-100" href="/works/overview">完整总览</a>
		</div>

		{recentEntries.length > 0 ? (
			<ul class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
				{
					recentEntries.map((entry) => (
						<li class="overflow-hidden rounded-[1.75rem] border border-neutral-200 bg-white dark:border-neutral-700 dark:bg-neutral-950/20">
							<div
								class="relative min-h-44 overflow-hidden border-b border-neutral-200/80 p-5 dark:border-neutral-700/80"
								style={`background: linear-gradient(135deg, ${entry.accent.from}, ${entry.accent.to}); box-shadow: inset 0 0 0 1px ${entry.accent.glow};`}
							>
								{entry.cover && (
									<img
										src={entry.cover}
										alt={`${entry.title} cover`}
										class="absolute inset-0 h-full w-full object-cover opacity-45"
										style={entry.coverPosition ? `object-position: ${entry.coverPosition};` : ''}
										loading="lazy"
									/>
								)}
								<div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(255,255,255,0.35),transparent_35%),linear-gradient(180deg,rgba(255,255,255,0.12),rgba(0,0,0,0.14))]"></div>
								<div class="relative flex h-full flex-col justify-between text-neutral-950">
									<div class="flex items-center justify-between gap-3">
										<span class="rounded-full border border-black/10 bg-white/35 px-3 py-1 text-xs font-semibold uppercase tracking-[0.25em]">
											{mediumLabel[entry.medium]}
										</span>
										<span class="text-sm opacity-65">{formatDate(entry.updatedAt)}</span>
									</div>
									<div class="space-y-3">
										<p class="max-w-[10rem] text-3xl font-black tracking-[0.08em]">
											{coverTitle(entry.title, entry.shortTitle)}
										</p>
										<p class="max-w-[16rem] text-sm leading-6 opacity-80">{entry.progress}</p>
									</div>
								</div>
							</div>
							<div class="space-y-3 p-5">
								<div class="flex items-start justify-between gap-4">
									<div>
										<h3 class="text-xl font-bold">{entry.title}</h3>
										<p class="mt-1 text-sm opacity-70">{statusLabel[entry.status]}</p>
									</div>
									{entry.year && <p class="text-sm opacity-55">{entry.year}</p>}
								</div>
								{entry.note && <p class="leading-7 opacity-80">{entry.note}</p>}
							</div>
						</li>
					))
				}
			</ul>
		) : (
			<div class="rounded-[2rem] border border-dashed border-neutral-300 px-6 py-8 opacity-70 dark:border-neutral-700">
				<p class="max-w-2xl leading-7">
					目前还没有标记为“最近在追”的条目。给 `src/data/works.ts`
					里的作品设成 `active`，它就会出现在这里。
				</p>
			</div>
		)}
	</section>
</section>
